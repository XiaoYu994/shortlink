GHCR_IMAGE_TAG=latest
SPRING_PROFILES_ACTIVE=aggregation
DATABASE_ENV=prod

# true = this project starts the container. false = reuse an existing service.
# One-click default keeps all true.
MANAGE_MYSQL=true
MANAGE_REDIS=true
MANAGE_NACOS=true
MANAGE_ROCKETMQ=true

# Used by app containers. When MANAGE_*=true, keep the docker service names.
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=link
MYSQL_COLD_DATABASE=link_cold
SHORTLINK_SHARD_COUNT=16

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=xhy_redis

# App container address, e.g. nacos:8848 or host.docker.internal:8848
NACOS_SERVER_ADDR=nacos:8848
# Host-reachable URL for deploy scripts. Required when MANAGE_NACOS=false
# and NACOS_SERVER_ADDR is a Docker-only name.
NACOS_ADDR=
NACOS_AUTH_ENABLE=true
NACOS_USERNAME=nacos
NACOS_PASSWORD=nacos
# Base64 of 32+ bytes. Replace in production.
NACOS_AUTH_TOKEN=c2hvcnRsaW5rLW5hY29zLWF1dGgtdG9rZW4tMzJiISE=
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=shortlink
NACOS_NAMESPACE=
NACOS_CONFIG_OVERWRITE=false

ROCKETMQ_NAME_SERVER=namesrv:9876

# Join an existing infra compose network when reusing middleware containers.
DOCKER_NETWORK=shortlink-network
DOCKER_EXTERNAL_NETWORK=

# Seeded into Nacos on first deploy. Later edits stay in Nacos unless
# NACOS_CONFIG_OVERWRITE=true.
SHORT_LINK_DOMAIN_DEFAULT=short.your-domain.example
SHORT_LINK_DOMAIN_PROTOCOL=http
SHORT_LINK_STATS_LOCALE_AMAP_KEY=

# URL 风控模型。改 Key 后需重启 aggregation。
# provider 留空：有 Key 时按 dashscope；none 关闭；openai 为兼容协议。
# openai 的 base-url：https://api.openai.com / https://api.deepseek.com / https://api.x.ai
RISK_AI_PROVIDER=
RISK_AI_API_KEY=
RISK_AI_MODEL=
RISK_AI_BASE_URL=
# 仅当 RISK_AI_API_KEY 为空时作为 Key
DASHSCOPE_API_KEY=

GHCR_USERNAME=
GHCR_TOKEN=
